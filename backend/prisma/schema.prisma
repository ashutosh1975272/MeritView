generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String          @id @default(uuid())
  email                String          @unique @db.VarChar(255)
  emailVerified        Boolean         @default(false)
  passwordHash         String?         @db.VarChar(255)
  displayName          String?         @db.VarChar(100)
  oauthProvider        String?         @db.VarChar(20)
  oauthSubject         String?         @db.VarChar(255)
  totpSecret           String?         @db.VarChar(255)
  preferredLlmProvider String?         @db.VarChar(50)
  marketingOptIn       Boolean         @default(false)
  timezone             String?         @db.VarChar(50)
  locale               String          @default("en-US") @db.VarChar(10)
  accountType          UserAccountType @default(STANDARD)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?
  lastLoginAt          DateTime?
  termsAcceptedAt      DateTime?       @map("terms_accepted_at")
  termsVersion         String?         @map("terms_version") @db.VarChar(10)
  mediator             Mediator?
  disputes             Dispute[]       @relation("DisputeInitiator")
  documents            Document[]      @relation("DocumentUploader")
  referralPartnerships MediatorPartnership[] @relation("PartnershipReferral")
  parties              Party[]         @relation("PartyUser")
  payments             Payment[]
  refreshTokens        RefreshToken[]

  @@index([email])
  @@index([createdAt], map: "idx_users_created_at")
  @@map("users")
}

model Dispute {
  id                 String             @id @default(uuid())
  category           DisputeCategory
  title              String             @db.VarChar(200)
  summary            String?
  estimatedStakesUsd Decimal?           @db.Decimal(12, 2)
  state              DisputeState       @default(DRAFT)
  stateChangedAt     DateTime           @default(now())
  pricingTier        PricingTier        @default(STANDARD)
  priceUsd           Decimal            @db.Decimal(8, 2)
  initiatorUserId    String             @map("initiator_user_id")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  completedAt        DateTime?
  deletedAt          DateTime?
  briefPrepSessions  BriefPrepSession[]
  briefs             Brief[]
  initiator          User               @relation("DisputeInitiator", fields: [initiatorUserId], references: [id])
  documents          Document[]
  evaluatorOutputs   EvaluatorOutput[]
  opinions           Opinion?
  parties            Party[]
  payments           Payment[]
  mediatorPartnerships MediatorPartnership[]

  @@index([initiatorUserId], map: "idx_disputes_initiator")
  @@index([state], map: "idx_disputes_state_active")
  @@index([createdAt], map: "idx_disputes_created_at")
  @@map("disputes")
}

model Party {
  id                   String             @id @default(uuid())
  disputeId            String             @map("dispute_id")
  role                 PartyRole
  userId               String?            @map("user_id")
  invitationEmail      String?            @map("invitation_email") @db.VarChar(255)
  invitationToken      String?            @unique @map("invitation_token") @db.VarChar(64)
  invitationStatus     InvitationStatus   @default(PENDING) @map("invitation_status")
  invitationSentAt     DateTime?          @map("invitation_sent_at")
  invitationExpiresAt  DateTime?          @map("invitation_expires_at")
  invitationAcceptedAt DateTime?          @map("invitation_accepted_at")
  briefStatus          BriefStatus        @default(NOT_STARTED) @map("brief_status")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  briefPrepSessions    BriefPrepSession[]
  briefs               Brief?
  documents            Document[]         @relation("DocumentParty")
  dispute              Dispute            @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  user                 User?              @relation("PartyUser", fields: [userId], references: [id])
  invitations          Invitation[]

  @@unique([disputeId, role])
  @@index([disputeId], map: "idx_parties_dispute")
  @@index([userId], map: "idx_parties_user")
  @@index([invitationToken], map: "idx_parties_invitation_token")
  @@map("parties")
}

model Brief {
  id                     String     @id @default(uuid())
  partyId                String     @unique @map("party_id")
  disputeId              String     @map("dispute_id")
  encryptedContent       Bytes      @map("encrypted_content")
  contentEncryptionKeyId String     @map("content_encryption_key_id") @db.VarChar(64)
  wordCount              Int        @map("word_count")
  supportingDocumentIds  String[]   @map("supporting_document_ids")
  status                 BriefState @default(DRAFT)
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt
  submittedAt            DateTime?  @map("submitted_at")
  sealedAt               DateTime?  @map("sealed_at")
  sealHash               String?    @map("seal_hash") @db.VarChar(64)
  dispute                Dispute    @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  party                  Party      @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([disputeId], map: "idx_briefs_dispute")
  @@index([status], map: "idx_briefs_status")
  @@map("briefs")
}

model BriefPrepSession {
  id                String                 @id @default(uuid())
  partyId           String                 @map("party_id")
  disputeId         String                 @map("dispute_id")
  llmProvider       String                 @map("llm_provider") @db.VarChar(50)
  modelId           String                 @map("model_id") @db.VarChar(100)
  encryptedMessages Bytes                  @map("encrypted_messages")
  messageCount      Int                    @default(0) @map("message_count")
  totalInputTokens  Int                    @default(0) @map("total_input_tokens")
  totalOutputTokens Int                    @default(0) @map("total_output_tokens")
  totalCostUsd      Decimal                @default(0) @map("total_cost_usd") @db.Decimal(8, 4)
  status            BriefPrepSessionStatus @default(ACTIVE)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  lastActivityAt    DateTime               @default(now()) @map("last_activity_at")
  completedAt       DateTime?              @map("completed_at")
  purgeAfter        DateTime?              @map("purge_after")
  dispute           Dispute                @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  party             Party                  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId], map: "idx_brief_sessions_party")
  @@index([purgeAfter], map: "idx_brief_sessions_purge")
  @@map("brief_prep_sessions")
}

model EvaluatorOutput {
  id               String   @id @default(uuid())
  disputeId        String   @map("dispute_id")
  llmProvider      String   @map("llm_provider") @db.VarChar(50)
  modelId          String   @map("model_id") @db.VarChar(100)
  promptVersion    String   @map("prompt_version") @db.VarChar(20)
  structuredOutput Json     @map("structured_output")
  rawOutput        String?  @map("raw_output")
  parseSuccess     Boolean  @map("parse_success")
  parseErrors      Json?
  inputTokens      Int      @map("input_tokens")
  outputTokens     Int      @map("output_tokens")
  costUsd          Decimal  @map("cost_usd") @db.Decimal(8, 4)
  durationMs       Int      @map("duration_ms")
  attemptNumber    Int      @default(1) @map("attempt_number")
  createdAt        DateTime @default(now())
  dispute          Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId], map: "idx_eval_outputs_dispute")
  @@index([llmProvider, modelId], map: "idx_eval_outputs_provider")
  @@map("evaluator_outputs")
}

model Opinion {
  id                      String    @id @default(uuid())
  disputeId               String    @unique @map("dispute_id")
  encryptedContent        Bytes     @map("encrypted_content")
  contentEncryptionKeyId  String    @map("content_encryption_key_id") @db.VarChar(64)
  evalPromptVersion       String    @map("eval_prompt_version") @db.VarChar(20)
  aggPromptVersion        String    @map("agg_prompt_version") @db.VarChar(20)
  evaluatorOutputIds      String[]  @map("evaluator_output_ids")
  interEvaluatorAgreement Decimal?  @map("inter_evaluator_agreement") @db.Decimal(4, 3)
  overallConfidence       Decimal?  @map("overall_confidence") @db.Decimal(4, 3)
  aggregatorProvider      String    @map("aggregator_provider") @db.VarChar(50)
  aggregatorModelId       String    @map("aggregator_model_id") @db.VarChar(100)
  totalCostUsd            Decimal   @map("total_cost_usd") @db.Decimal(8, 4)
  pdfStorageKey           String?   @map("pdf_storage_key") @db.VarChar(255)
  pdfGeneratedAt          DateTime? @map("pdf_generated_at")
  createdAt               DateTime  @default(now())
  deliveredAt             DateTime? @map("delivered_at")
  dispute                 Dispute   @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([createdAt], map: "idx_opinions_created")
  @@map("opinions")
}

model Document {
  id                      String            @id @default(uuid())
  disputeId               String            @map("dispute_id")
  uploadedByUserId        String            @map("uploaded_by_user_id")
  uploadedByPartyId       String            @map("uploaded_by_party_id")
  filename                String            @db.VarChar(255)
  sizeBytes               BigInt            @map("size_bytes")
  mimeType                String            @map("mime_type") @db.VarChar(100)
  storageKey              String            @map("storage_key") @db.VarChar(255)
  storageBucket           String            @map("storage_bucket") @db.VarChar(100)
  encryptionKeyId         String            @map("encryption_key_id") @db.VarChar(64)
  ocrStatus               DocumentOCRStatus @default(NOT_REQUESTED) @map("ocr_status")
  extractedTextStorageKey String?           @map("extracted_text_storage_key") @db.VarChar(255)
  description             String?
  createdAt               DateTime          @default(now())
  deletedAt               DateTime?
  dispute                 Dispute           @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploadedByParty         Party             @relation("DocumentParty", fields: [uploadedByPartyId], references: [id])
  uploadedByUser          User              @relation("DocumentUploader", fields: [uploadedByUserId], references: [id])

  @@index([disputeId], map: "idx_documents_dispute")
  @@index([uploadedByPartyId], map: "idx_documents_party")
  @@map("documents")
}

model Mediator {
  id                String               @id @default(uuid())
  userId            String               @unique @map("user_id")
  businessName      String               @map("business_name") @db.VarChar(200)
  description       String?              @db.Text
  specialties       String[]             @default([])
  serviceRegions    String[]             @map("service_regions")
  contactEmail      String               @map("contact_email") @db.VarChar(255)
  website           String?              @db.VarChar(500)
  status            MediatorStatus       @default(PENDING)
  ratingAvg         Decimal              @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount       Int                  @default(0) @map("rating_count")
  completedReferrals Int                 @default(0) @map("completed_referrals")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  user              User                 @relation(fields: [userId], references: [id])
  partnerships      MediatorPartnership[]

  @@index([status], map: "idx_mediators_status")
  @@index([specialties], map: "idx_mediators_specialties")
  @@map("mediators")
}

model MediatorPartnership {
  id                String             @id @default(uuid())
  mediatorId        String             @map("mediator_id")
  disputeId         String             @map("dispute_id")
  referralUserId    String             @map("referral_user_id")
  commissionPct     Decimal            @map("commission_pct") @db.Decimal(4, 2)
  status            PartnershipStatus  @default(ACTIVE)
  referredAt        DateTime           @default(now()) @map("referred_at")
  acceptedAt        DateTime?          @map("accepted_at")
  completedAt       DateTime?          @map("completed_at")
  revenueShareUsd   Decimal?           @map("revenue_share_usd") @db.Decimal(8, 2)
  mediator          Mediator           @relation(fields: [mediatorId], references: [id], onDelete: Cascade)
  dispute           Dispute            @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  referralUser      User               @relation("PartnershipReferral", fields: [referralUserId], references: [id])

  @@unique([mediatorId, disputeId])
  @@index([mediatorId], map: "idx_partnerships_mediator")
  @@index([disputeId], map: "idx_partnerships_dispute")
  @@map("mediator_partnerships")
}

model Payment {
  id                 String        @id @default(uuid())
  disputeId          String        @map("dispute_id")
  userId             String        @map("user_id")
  amountUsd          Decimal       @map("amount_usd") @db.Decimal(8, 2)
  currency           String        @default("USD") @db.VarChar(3)
  processor          String        @default("stripe") @db.VarChar(20)
  processorPaymentId String        @unique @map("processor_payment_id") @db.VarChar(255)
  processorChargeId  String?       @map("processor_charge_id") @db.VarChar(255)
  status             PaymentStatus
  refundedAmountUsd  Decimal       @default(0) @map("refunded_amount_usd") @db.Decimal(8, 2)
  refundReason       String?       @map("refund_reason")
  refundedAt         DateTime?     @map("refunded_at")
  idempotencyKey     String?       @unique @map("idempotency_key") @db.VarChar(64)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  completedAt        DateTime?     @map("completed_at")
  dispute            Dispute       @relation(fields: [disputeId], references: [id])
  user               User          @relation(fields: [userId], references: [id])

  @@index([disputeId], map: "idx_payments_dispute")
  @@index([userId], map: "idx_payments_user")
  @@map("payments")
}

model AuditEvent {
  id           String   @id @default(uuid())
  actorId      String   @map("actor_id")
  actorType    String   @map("actor_type") @db.VarChar(50)
  eventType    String   @map("event_type") @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(50)
  resourceId   String   @map("resource_id") @db.VarChar(40)
  metadata     Json?
  requestId    String?  @map("request_id")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent")
  prevEventId  String?  @map("prev_event_id")
  signature    String?  @db.VarChar(64)
  createdAt    DateTime @default(now())

  @@index([actorId], map: "idx_audit_events_actor")
  @@index([resourceType, resourceId], map: "idx_audit_events_resource")
  @@index([createdAt], map: "idx_audit_events_created")
  @@map("audit_events")
}

model Invitation {
  id        String   @id @default(cuid())
  partyId   String   @unique @map("party_id")
  createdAt DateTime @default(now())

  party           Party             @relation(fields: [partyId], references: [id], onDelete: Cascade)
  invitationEvents InvitationEvent[]

  @@map("invitations")
}

model InvitationEvent {
  id            String   @id @default(cuid())
  invitationId  String   @map("invitation_id")
  eventType     String   @map("event_type") @db.VarChar(20)
  metadata      Json?
  createdAt     DateTime @default(now())

  invitation    Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("invitation_events")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now())
  revokedAt DateTime? @map("revoked_at")

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

enum UserRole {
  STANDARD
  ADMIN
  SUPPORT
}

enum UserAccountType {
  STANDARD
  GUEST
  ADMIN
  SUPPORT
}

enum DisputeState {
  DRAFT
  AWAITING_COUNTERPARTY
  IN_PROGRESS
  AWAITING_BRIEFS
  AWAITING_COUNTERPARTY_BRIEF
  PAYMENT_PENDING
  UNDER_ANALYSIS
  COMPLETED
  WITHDRAWN
  DECLINED
  EXPIRED
  FAILED
  REANALYSIS_IN_PROGRESS
}

enum DisputeCategory {
  CONTRACT_INTERPRETATION
  SMALL_CLAIMS_ASSESSMENT
  PARTNERSHIP_CONFLICT
}

enum PricingTier {
  STANDARD
  EXPEDITED
  EXTENDED
  REANALYSIS
}

enum PartyRole {
  INITIATOR
  RESPONDENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

enum BriefStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
}

enum BriefState {
  DRAFT
  SUBMITTED
  SEALED
}

enum BriefPrepSessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
  PURGED
}

enum EvaluatorOutputParseSuccess {
  TRUE
  FALSE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum DocumentOCRStatus {
  NOT_REQUESTED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MediatorStatus {
  PENDING
  APPROVED
  SUSPENDED
  INACTIVE
}

enum PartnershipStatus {
  ACTIVE
  ACCEPTED
  COMPLETED
  CANCELLED
}
